# External PostgreSQL database
DB_HOST=
DB_PORT=5432
DB_NAME=entrack_plataforma
DB_USER=entrack_plataforma
DB_PASSWORD=change-me
DB_SSL_MODE=require

# Required by the business backend for OpenAI-powered features.
OPENAI_API_KEY=

GOOGLE_MAPS_API_KEY=

# External MediaMTX endpoints.
MEDIAMTX_WEBRTC_URL=https://media.example.com
MEDIAMTX_RTMP_URL=rtmp://media.example.com:1936/live
MEDIAMTX_RTSP_URL=rtsp://media.example.com:8554

# Public dashboard URL.
APP_URL=http://localhost

# Receiver notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FIREBASE_SERVICE_ACCOUNT=
SMS_HTTP_URL=
SMS_HTTP_AUTHORIZATION=

# Receiver location services.
GEOCODER_URL=
GEOLOCATION_KEY=
GEOLOCATION_URL=

# Pin these to immutable release versions for production deployments.
DASHBOARD_VERSION=latest
BACKEND_VERSION=latest
RECEIVER_VERSION=latest

JAVA_OPTS=-Xms256m -Xmx1g
