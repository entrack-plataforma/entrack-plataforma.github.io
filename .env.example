# External PostgreSQL database managed by the customer.
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=entrack_plataforma
DB_USER=entrack_plataforma
DB_PASSWORD=change-me
DB_SSL_MODE=require

# Required by the business backend for OpenAI-powered features.
OPENAI_API_KEY=replace-with-customer-openai-api-key
GOOGLE_MAPS_API_KEY=replace-with-customer-google-maps-api-key

# Public dashboard URL.
APP_URL=http://localhost

# Receiver notifications. Add mail,sms,firebase,command only after configuring them.
NOTIFICATOR_TYPES=web
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FIREBASE_SERVICE_ACCOUNT=
SMS_HTTP_URL=
SMS_HTTP_AUTHORIZATION=

# Optional receiver location services.
GEOCODER_ENABLE=false
GEOCODER_URL=http://backend:8080/reverse
GEOLOCATION_ENABLE=false
GEOLOCATION_TYPE=unwired
GEOLOCATION_KEY=
GEOLOCATION_URL=https://us1.unwiredlabs.com/v2/process

# Optional OpenID Connect login.
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_AUTH_DOMAIN=

# Optional receiver forwarding to the business backend.
FORWARD_ENABLE=false
FORWARD_URL=http://backend:8080
EVENT_FORWARD_ENABLE=false
EVENT_FORWARD_URL=http://backend:8080/events

# Pin these to immutable release versions for production deployments.
DASHBOARD_VERSION=latest
BACKEND_VERSION=latest
RECEIVER_VERSION=latest

JAVA_OPTS=-Xms256m -Xmx1g
